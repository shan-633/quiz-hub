{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "zhixu.question-bank"
    },
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "bank": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "default": "",
          "type": "string",
          "maxLength": 3000
        },
        "chapter": {
          "default": "",
          "type": "string",
          "maxLength": 100
        },
        "minutes": {
          "default": 30,
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "accent": {
          "default": "exam",
          "type": "string",
          "enum": [
            "mechanics",
            "electric",
            "buoyancy",
            "exam"
          ]
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "questions": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?!(?:__proto__|prototype|constructor|__defineGetter__|__defineSetter__|hasOwnProperty|__lookupGetter__|__lookupSetter__|isPrototypeOf|propertyIsEnumerable|toString|valueOf|toLocaleString)$)[a-zA-Z0-9_-]{1,128}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "single",
              "multiple",
              "fill",
              "experiment",
              "reading",
              "calculation"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "score": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "difficulty": {
            "default": "基础",
            "type": "string",
            "maxLength": 50
          },
          "tags": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "source": {
            "type": "string",
            "maxLength": 1000
          },
          "content": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
