                }
              },
              "explanation": {
                "type": "string",
                "maxLength": 100000
              },
              "referenceImages": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "assetId": {
                      "type": "string",
